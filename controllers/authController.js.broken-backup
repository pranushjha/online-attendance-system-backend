// ==========================================
// VERIFY EMAIL
// ADMIN OR TEACHER
// ==========================================

const verifyEmail = async (req, res) => {
    try {

        const { token } = req.query;

        if (!token) {
            return res.status(400).json({
                success: false,
                message:
                    "Verification token is required",
            });
        }

        const tokenHash =
            hashToken(token);

        const now = new Date();

        // Try admin first
        const admin =
            await Admin.findOne({
                emailVerificationTokenHash:
                    tokenHash,
                emailVerificationExpires: {
                    $gt: now,
                },
            });

        if (admin) {

            admin.isEmailVerified =
                true;

            admin.emailVerificationTokenHash =
                null;

            admin.emailVerificationExpires =
                null;

            await admin.save();

            return res.status(200).json({
                success: true,
                role: "admin",
                message:
                    "Email verified successfully. You can now log in.",
            });
        }

        // Try teacher
        const teacher =
            await Teacher.findOne({
                emailVerificationTokenHash:
                    tokenHash,
                emailVerificationExpires: {
                    $gt: now,
                },
            });

        if (teacher) {

            teacher.isEmailVerified =
                true;

            teacher.emailVerificationTokenHash =
                null;

            teacher.emailVerificationExpires =
                null;

            await teacher.save();

            return res.status(200).json({
                success: true,
                role: "teacher",
                message:
                    "Email verified successfully. You can now log in.",
            });
        }

        return res.status(400).json({
            success: false,
            message:
                "Invalid or expired verification link",
        });

    } catch (error) {

        console.error(
            "Verify Email Error:",
            error
        );

        return res.status(500).json({
            success: false,
            message:
                "Server error while verifying email",
        });
    }
};


